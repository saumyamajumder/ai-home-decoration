# Copy to .env.local and fill in real values. Never commit real keys.
# Variables without NEXT_PUBLIC_ stay on the server and are never sent to the browser.

# Google Gemini: room analysis and instruction preparation (https://aistudio.google.com/apikey)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# A text/vision model available to your key, e.g. gemini-3.8-flash
GEMINI_MODEL=YOUR_AVAILABLE_GEMINI_MODEL
# Optional, comma-separated: tried in order when GEMINI_MODEL is overloaded or out of quota,
# e.g. gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=YOUR_FALLBACK_GEMINI_MODEL

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server only: bypasses Row Level Security
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY

# Image-editing model (must support image output). Leave as placeholder to disable generation.
# Gemini image models need billing enabled on the Google AI Studio project (free tier quota is 0).
GEMINI_IMAGE_MODEL=YOUR_GEMINI_IMAGE_MODEL
